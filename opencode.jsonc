{
  "$schema": "https://opencode.ai/config.json",
  "provider": {},
  "model": "opencode/deepseek-v4-flash-free",
  "small_model": "opencode/mimo-v2.5-free",
  "permission": {
    "bash": "allow",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "edit": {
      "packages/opencode/migration/*": "ask",
      "*": "allow"
    },
    "todowrite": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "mcp_filesystem_*": "allow",
    "mcp_go-docs-mcp_*": "allow",
    "mcp_imagine-mcp_*": "ask",
    "mcp_pdf-mcp_*": "allow",
    "mcp_higgsfield_*": "allow"
  },
  "plugin": [
    "opencode-memfs",
    "opencode-vibeguard",
    "opencode-cross-repo",
    "@franlol/opencode-md-table-formatter@latest",
    "oh-my-opencode-slim",
    "opencode-memory-plugin"
  ],
  "mcp": {
    "supabase": {
      "type": "remote",
      "url": "https://mcp.supabase.com/mcp?project_ref=reewcfpjlnufktvahtii",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:SUPABASE_ACCESS_TOKEN}"
      }
    },
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@context7/mcp"
      ],
      "enabled": true,
      "env": {}
    },
    "firecrawl": {
      "type": "local",
      "command": [
        "/usr/local/bin/firecrawl-mcp"
      ],
      "enabled": true,
      "env": {
        "FIRECRAWL_API_KEY": "fc-fa44b144989b491fb29968f80107f8d0"
      }
    },
    "filesystem": {
      "type": "local",
      "command": [
        "/usr/local/bin/mcp-server-filesystem"
      ],
      "args": [
        "/home/.config/opencode",
        "/public",
        "/data/user/0/com.foxdebug.acode/cache/opencode"
      ],
      "enabled": true,
      "env": {}
    },
    "go-docs-mcp": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "github:drolosoft/go-docs-mcp"
      ],
      "enabled": true,
      "env": {}
    },
    "higgsfield": {
      "type": "remote",
      "url": "https://mcp.higgsfield.ai/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer hf_buo9MKYRyJdufHAuDD6GCv0Y9_NmFylQCV_vbLvsTiQTLfygA3ah6GiiUSG3ucZF",
        "User-Agent": "Mozilla/5.0 (Linux; Android 14) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Mobile Safari/537.36",
        "Origin": "https://higgsfield.ai",
        "Referer": "https://higgsfield.ai/"
      }
    },
    "pdf-mcp": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "pdf-mcp"
      ],
      "enabled": true,
      "env": {}
    }
  },
  "tools": {
    "github-triage": false,
    "github-pr-search": false,
    "analyze_image": true,
    "transcribe_audio": true,
    "parse_document": true,
    "audit_agents": true,
    "improve_agent": true,
    "track_performance": true
  }
}