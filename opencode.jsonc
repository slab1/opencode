{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/deepseek-v4-flash-free",
  "small_model": "opencode/mimo-v2.5-free",
  "permission": {
    "bash": "allow",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "edit": {
      "packages/opencode/migration/*": "ask",
      "*": "allow"
    },
    "todowrite": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "mcp_filesystem_*": "allow",
    "mcp_pdf-mcp_*": "allow",
    "mcp_firecrawl_*": "ask",
    "mcp_go-docs-mcp_*": "ask",
    "mcp_bulkpublish_*": "ask",
    "mcp_trypost_*": "ask",
    "mcp_mobile-device_*": "allow"
  },
  "plugin": [
    "opencode-memfs",
    "opencode-vibeguard",
    "opencode-cross-repo",
    "@franlol/opencode-md-table-formatter@latest",
    "oh-my-opencode-slim",
    // "opencode-memory-plugin" // DISABLED - was causing terminal crashes and slowdown
  ],
  "mcp": {
    "supabase": {
      "type": "remote",
      "url": "https://mcp.supabase.com/mcp?project_ref=reewcfpjlnufktvahtii",
      "enabled": false,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:SUPABASE_ACCESS_TOKEN}"
      }
    },
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@context7/mcp"
      ],
      "enabled": true,
      "env": {}
    },
    "filesystem": {
      "type": "local",
      "command": [
        "/usr/local/bin/mcp-server-filesystem"
      ],
      "args": [
        "/root/.config/opencode",
        "/root/projects"
      ],
      "enabled": true,
      "env": {}
    },
    "firecrawl": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "firecrawl-mcp"
      ],
      "enabled": false,
      "env": {
        "FIRECRAWL_API_KEY": "{env:FIRECRAWL_API_KEY}"
      },
      "description": "Needs Node >=22 (current: v20). Install: npm install -g firecrawl-mcp"
    },
    "go-docs-mcp": {
      "type": "local",
      "command": [
        "/usr/local/bin/go-docs-mcp"
      ],
      "enabled": false,
      "env": {},
      "description": "Go project — needs 'go install github.com/drolosoft/go-docs-mcp@latest'"
    },
    "pdf-mcp": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "pdf-mcp"
      ],
      "enabled": true,
      "env": {}
    },
    "bulkpublish": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@bulkpublish/mcp-server"
      ],
      "enabled": false,
      "env": {
        "BULKPUBLISH_API_KEY": "{env:BULKPUBLISH_API_KEY}"
      },
      "description": "11-platform social media scheduling (enable after getting API key from app.bulkpublish.com)"
    },
    "trypost": {
      "type": "remote",
      "url": "https://app.trypost.it/mcp/trypost",
      "enabled": false,
      "headers": {
        "Authorization": "Bearer {env:TRYPOST_API_KEY}"
      },
      "description": "Self-hosted social media scheduler (enable after self-hosting or cloud signup)"
    },
    "mobile-device": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@srmorete/mobile-device-mcp@latest"
      ],
      "enabled": true,
      "env": {
        "MDMS_PORT_ANDROID": "18000",
        "MDMS_PORT_IOS": "19000"
      },
      "description": "Control Android/iOS devices via ADB (auto-detects platform). Connect phone via USB with USB debugging enabled, then use list_devices, launch_app, screenshot, tap, etc."
    }
  },
  "tools": {
    "github-triage": false,
    "github-pr-search": false,
    "analyze_image": true,
    "transcribe_audio": true,
    "parse_document": true,
    "audit_agents": true,
    "improve_agent": true,
    "track_performance": true,
    "free_image_gen": true,
    "free_video_gen": true
  }
}
