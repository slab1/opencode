{
  "$schema": "https://opencode.ai/config.json",
  "provider": {},
  "model": "opencode/deepseek-v4-flash-free",
  // 💡 TIP: Set small_model to a cheaper/faster model for simple operations
  //    (grep, context extraction, simple rewrites) to reduce token costs.
  //    Example: "small_model": "opencode/gpt-4o-mini"
  "small_model": "opencode/deepseek-v4-flash-free",
  "permission": {
    "bash": "allow",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "edit": {
      "packages/opencode/migration/*": "ask",
      "*": "allow"
    },
    "todowrite": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    // ── Permission rules for meta-agent ──
    // meta-agent needs: edit (for modifying agent .md files), bash (for improvement engine),
    // task (delegating to review/test/explore), todowrite, webfetch, websearch
    // ── Permission rules for media-agent and document-agent ──
    // media-agent needs: read (for files), bash (for python processor), webfetch, websearch
    // document-agent needs: read (for files), bash (for pdftotext/pandoc), webfetch, websearch
    // These wildcard patterns match MCP tool names from configured servers:
    //   "mcp_filesystem_*" → @modelcontextprotocol/server-filesystem tools
    //   "mcp_go-docs-mcp_*" → go-docs-mcp tools  
    //   "mcp_imagine-mcp_*" → imagine-mcp tools
    //   "mcp_pdf-mcp_*" → pdf-mcp tools
    "mcp_filesystem_*": "allow",
    "mcp_go-docs-mcp_*": "allow",
    "mcp_imagine-mcp_*": "ask",
    "mcp_pdf-mcp_*": "allow"
  },
  "plugin": [
    "opencode-memfs",
    "opencode-vibeguard",
    "opencode-cross-repo",
    "@franlol/opencode-md-table-formatter@latest",
    // 🟢 Enabled via LD_PRELOAD shim: /usr/lib/libglibc_compat.so
    //    Provides glibc *64 symbols + libmvec for the native addon on musl.
    "opencode-codebase-index",
    "oh-my-opencode-slim",
    // 🧠 Memory plugin: auto-flushes context before compaction,
    //    injects recent context into prompts, provides memory_search tool
    "opencode-memory-plugin"
  ],
  "mcp": {
    // ── Existing Servers ──
    "supabase": {
      "type": "remote",
      "url": "https://mcp.supabase.com/mcp?project_ref=reewcfpjlnufktvahtii",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:SUPABASE_ACCESS_TOKEN}"
      }
    },
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@context7/mcp"],
      "enabled": true,
      "env": {}
    },
    "firecrawl": {
      "type": "local",
      "command": ["npx", "-y", "firecrawl-mcp"],
      "enabled": true,
      "env": {
        "FIRECRAWL_API_KEY": "fc-fa44b144989b491fb29968f80107f8d0"
      }
    },
    // ── Filesystem with Media Support ──
    // Provides read_text_file, read_media_file (images/audio), write_file, search, etc.
    "filesystem": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem"],
      "args": ["/home/.config/opencode", "/public", "/data/user/0/com.foxdebug.acode/cache/opencode"],
      "enabled": true,
      "env": {}
    },
    // ── Multi-Format Document Access ──
    // go-docs-mcp: 13 tools across PDF, TXT, MD, CSV, DOCX, Images
    // Tools: list_documents, read_document, search_document, extract_tables, 
    //        extract_images, ocr_document, read_image, convert_to_markdown, etc.
    // Falls back to pdftotext+poppler internally, with tesseract for scanned PDFs
    "go-docs-mcp": {
      "type": "local",
      "command": ["npx", "-y", "github:drolosoft/go-docs-mcp"],
      "enabled": true,
      "env": {}
    },
    // ── Advanced PDF Processing ──
    // pdf-mcp: hybrid search, OCR, table extraction, page rendering for vision models
    "pdf-mcp": {
      "type": "local",
      "command": ["npx", "-y", "pdf-mcp"],
      "enabled": true,
      "env": {}
    }
  },
  "tools": {
    "github-triage": false,
    "github-pr-search": false,
    // Enable media processing tools
    "analyze_image": true,
    "transcribe_audio": true,
    "parse_document": true,
    // Enable self-improvement tools (meta-agent)
    "audit_agents": true,
    "improve_agent": true,
    "track_performance": true
  }
}